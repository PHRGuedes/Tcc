classDiagram
    direction TB

    %% ==========================================
    %% ENUMERAÇÕES DO DOMÍNIO
    %% ==========================================
    class RequirementType {
        <<enumeration>>
        RF
        RNF
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
        CRITICAL
    }

    class RequirementStatus {
        <<enumeration>>
        PROPOSED
        UNDER_REVIEW
        APPROVED
        NOT_APPROVED
    }

    class StoryStatus {
        <<enumeration>>
        BACKLOG
        TODO
        IN_PROGRESS
        DONE
    }

    class SprintStatus {
        <<enumeration>>
        PLANNED
        ACTIVE
        COMPLETED
    }

    class DependencyType {
        <<enumeration>>
        CONFLICT
        COMPLEMENTS
        REFINES
        DEPENDS_ON
    }

    %% ==========================================
    %% ENTIDADES PRINCIPAIS
    %% ==========================================

    class Profile {
        +UUID id
        +String full_name
        +String email
        +String avatar_url
        +String system_role
        +DateTime created_at
        +DateTime updated_at
        +atualizarPerfil()
        +autenticar()
    }

    class Project {
        +UUID id
        +String name
        +String description
        +UUID created_by
        +DateTime created_at
        +DateTime updated_at
        +adicionarMembro(userId, role)
        +removerMembro(userId)
        +exportarDocumentoSRS()
        +gerarMetricas()
    }

    class ProjectMember {
        +UUID id
        +UUID project_id
        +UUID user_id
        +String role_in_project
        +DateTime joined_at
        +temPermissao(permissaoId)
    }

    class ProjectRole {
        +UUID id
        +UUID project_id
        +String name
        +String slug
        +String description
        +Boolean is_system
        +JSON permissions
        +adicionarPermissao(chave)
        +revogarPermissao(chave)
    }

    class ProjectInvitation {
        +UUID id
        +UUID project_id
        +UUID invited_user_id
        +UUID invited_by
        +String role_in_project
        +String status
        +DateTime created_at
        +aceitar()
        +recusar()
    }

    class Requirement {
        +UUID id
        +String code
        +String title
        +String description
        +RequirementType type
        +Priority priority
        +RequirementStatus status
        +String justification
        +String source
        +String acceptance_criteria
        +String rejection_reason
        +Boolean is_incomplete
        +Int current_version
        +UUID project_id
        +UUID responsible_id
        +DateTime created_at
        +DateTime updated_at
        +aprovar()
        +reprovar(motivo)
        +solicitarReavaliacao()
        +criarNovaVersao(resumo)
        +vincularUserStory(userStoryId)
        +adicionarDependencia(alvoId, tipo)
    }

    class RequirementVersion {
        +UUID id
        +UUID requirement_id
        +Int version_number
        +UUID changed_by
        +String change_summary
        +JSON snapshot
        +DateTime created_at
        +restaurarVersao()
        +compararCom(outraVersao)
    }

    class RequirementDependency {
        +UUID id
        +UUID source_req_id
        +UUID target_req_id
        +DependencyType dependency_type
        +DateTime created_at
        +validarCicloDependencia()
    }

    class UserStory {
        +UUID id
        +UUID project_id
        +String code
        +String title
        +String as_a
        +String i_want
        +String so_that
        +StoryStatus status
        +Priority priority
        +UUID sprint_id
        +UUID responsible_id
        +DateTime created_at
        +DateTime updated_at
        +atribuirSprint(sprintId)
        +desvincularParaBacklog()
        +atualizarStatusKanban(novoStatus)
    }

    class Sprint {
        +UUID id
        +UUID project_id
        +String name
        +String goal
        +Date start_date
        +Date end_date
        +SprintStatus status
        +DateTime created_at
        +iniciarSprint()
        +concluirSprint()
        +calcularVelocidade()
    }

    class AuditLog {
        +UUID id
        +UUID project_id
        +UUID user_id
        +String entity_type
        +String entity_id
        +String action
        +String description
        +JSON details
        +DateTime created_at
    }

    %% ==========================================
    %% RELACIONAMENTOS E CARDINALIDADES
    %% ==========================================

    %% Usuários e Projetos
    Profile "1" --> "0..*" Project : cria
    Project "1" *-- "1..*" ProjectMember : contem
    ProjectMember "0..*" --> "1" Profile : usuario
    Project "1" *-- "0..*" ProjectRole : define_papeis
    Project "1" *-- "0..*" ProjectInvitation : emite
    ProjectInvitation "0..*" --> "1" Profile : convidado

    %% Requisitos e Versionamento
    Project "1" *-- "0..*" Requirement : possui
    Requirement "0..*" --> "0..1" Profile : responsavel
    Requirement "1" *-- "1..*" RequirementVersion : versiona
    RequirementVersion "0..*" --> "0..1" Profile : autor

    %% Dependências de Requisitos (Auto-relacionamento N:N)
    RequirementDependency "0..*" --> "1" Requirement : origem
    RequirementDependency "0..*" --> "1" Requirement : alvo

    %% Rastreabilidade e Gestão Ágil
    Project "1" *-- "0..*" Sprint : planeja
    Project "1" *-- "0..*" UserStory : armazena
    Sprint "0..1" o-- "0..*" UserStory : aloca
    UserStory "0..*" --> "0..1" Profile : responsavel

    %% Matriz de Rastreabilidade Bidirecional (N:N Requisito <-> User Story)
    Requirement "0..*" -- "0..*" UserStory : rastreia

    %% Auditoria Geral
    Project "1" *-- "0..*" AuditLog : registra
    AuditLog "0..*" --> "0..1" Profile : autor
