flowchart LR
    %% ==========================================
    %% DIAGRAMA DE CASOS DE USO - REQFLOW (TCC)
    %% Padrão UML com compatibilidade universal Mermaid
    %% ==========================================

    %% Estilos visuais
    classDef actor fill:#1e293b,stroke:#3b82f6,stroke-width:2px,color:#f8fafc;
    classDef usecase fill:#0f172a,stroke:#38bdf8,stroke-width:1.5px,color:#e2e8f0;
    classDef secondary fill:#0284c7,stroke:#bae6fd,stroke-width:1.5px,color:#ffffff;

    %% Atores Principais (Usuários Humanos)
    PO["👤 Engenheiro de Requisitos / PO"]:::actor
    DEV["👤 Desenvolvedor / Equipe"]:::actor
    REV["👤 Avaliador / Stakeholder"]:::actor
    ADM["👤 Administrador do Projeto"]:::actor

    %% Ator Secundário (Sistema Externo)
    AUTH_SYS["⚙️ Supabase / Serviço de Autenticação"]:::secondary

    %% Limite do Sistema (System Boundary)
    subgraph ReqFlow ["ReqFlow - Sistema de Gestão de Requisitos"]
        %% Autenticação e Acesso
        UC01(["UC01: Autenticar no Sistema"]):::usecase
        UC02(["UC02: Gerenciar Projetos"]):::usecase
        UC03(["UC03: Gerenciar Membros e Papéis RBAC"]):::usecase

        %% Engenharia e Ciclo de Vida de Requisitos
        UC04(["UC04: Manter Requisitos RF e RNF"]):::usecase
        UC05(["UC05: Versionar Requisito"]):::usecase
        UC06(["UC06: Avaliar Requisito (Aprovar / Reprovar)"]):::usecase
        UC07(["UC07: Mapear Dependências e Conflitos"]):::usecase

        %% Rastreabilidade e Gestão Ágil
        UC08(["UC08: Manter User Stories"]):::usecase
        UC09(["UC09: Estabelecer Rastreabilidade Requisito ↔ Story"]):::usecase
        UC10(["UC10: Planejar Sprints"]):::usecase
        UC11(["UC11: Gerenciar Itens no Kanban da Sprint"]):::usecase

        %% Relatórios e Governança
        UC12(["UC12: Exportar Documento SRS em PDF"]):::usecase
        UC13(["UC13: Visualizar Relatórios e Métricas de Qualidade"]):::usecase
        UC14(["UC14: Consultar Trilha de Auditoria"]):::usecase
    end

    %% Associações dos Atores com Casos de Uso
    ADM --> UC02
    ADM --> UC03
    ADM --> UC14

    PO --> UC04
    PO --> UC07
    PO --> UC08
    PO --> UC09
    PO --> UC10
    PO --> UC12
    PO --> UC13

    DEV --> UC08
    DEV --> UC09
    DEV --> UC11
    DEV --> UC13

    REV --> UC06
    REV --> UC12
    REV --> UC13

    %% Relações de Inclusão e Extensão (UML <<include>> / <<extend>>)
    UC04 -.->|include| UC01
    UC04 -.->|include| UC05
    UC06 -.->|extend| UC04
    UC09 -.->|include| UC08
    UC10 -.->|include| UC08
    UC12 -.->|include| UC04

    %% Associação com Ator Secundário
    UC01 --> AUTH_SYS
